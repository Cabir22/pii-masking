{"id": "homograph_pairs_001", "text": "Gözəl bir gün idi, Gözəllə parkda gəzdik.", "lang": "az", "family": "homograph_pairs", "pair": 0, "role": "pair", "entities": [{"start": 19, "end": 26, "label": "GIVENNAME"}], "controls": [{"start": 0, "end": 5, "resembles": "GIVENNAME", "kind": "homograph_word"}]}
{"id": "homograph_pairs_002", "text": "Səhərə dedim ki, səhər tezdən gəlsin.", "lang": "az", "family": "homograph_pairs", "pair": 1, "role": "pair", "entities": [{"start": 0, "end": 6, "label": "GIVENNAME"}], "controls": [{"start": 17, "end": 22, "resembles": "GIVENNAME", "kind": "homograph_word"}]}
{"id": "homograph_pairs_003", "text": "Həyat bahalaşıb, Həyatın da maaşı artmayıb.", "lang": "az", "family": "homograph_pairs", "pair": 2, "role": "pair", "entities": [{"start": 17, "end": 24, "label": "GIVENNAME"}], "controls": [{"start": 0, "end": 5, "resembles": "GIVENNAME", "kind": "homograph_word"}]}
{"id": "homograph_pairs_004", "text": "Sakit otağa girəndə hamı sakit oturmuşdu.", "lang": "az", "family": "homograph_pairs", "pair": 3, "role": "pair", "entities": [{"start": 0, "end": 5, "label": "GIVENNAME"}], "controls": [{"start": 25, "end": 30, "resembles": "GIVENNAME", "kind": "homograph_word"}]}
{"id": "homograph_pairs_005", "text": "Nəsim pəncərədən içəri doldu, Nəsim isə yatmışdı.", "lang": "az", "family": "homograph_pairs", "pair": 4, "role": "pair", "entities": [{"start": 30, "end": 35, "label": "GIVENNAME"}], "controls": [{"start": 0, "end": 5, "resembles": "GIVENNAME", "kind": "homograph_word"}]}
{"id": "homograph_pairs_006", "text": "Yaqutun üzüyündəki daş yaqut deyil, şüşədir.", "lang": "az", "family": "homograph_pairs", "pair": 5, "role": "pair", "entities": [{"start": 0, "end": 7, "label": "GIVENNAME"}], "controls": [{"start": 23, "end": 28, "resembles": "GIVENNAME", "kind": "homograph_word"}]}
{"id": "homograph_pairs_007", "text": "Firuzə rəngli parçanı Firuzəyə bağışladım.", "lang": "az", "family": "homograph_pairs", "pair": 6, "role": "pair", "entities": [{"start": 22, "end": 30, "label": "GIVENNAME"}], "controls": [{"start": 0, "end": 6, "resembles": "GIVENNAME", "kind": "homograph_word"}]}
{"id": "homograph_pairs_008", "text": "Zümrüd dedi ki, boyunbağının daşları zümrüddür.", "lang": "az", "family": "homograph_pairs", "pair": 7, "role": "pair", "entities": [{"start": 0, "end": 6, "label": "GIVENNAME"}], "controls": [{"start": 37, "end": 46, "resembles": "GIVENNAME", "kind": "homograph_word"}]}
{"id": "homograph_pairs_009", "text": "İnamını itirmə, İnam sənə kömək edəcək.", "lang": "az", "family": "homograph_pairs", "pair": 8, "role": "pair", "entities": [{"start": 16, "end": 20, "label": "GIVENNAME"}], "controls": [{"start": 0, "end": 7, "resembles": "GIVENNAME", "kind": "homograph_word"}]}
{"id": "homograph_pairs_010", "text": "Vüsala yazdım ki, uzun ayrılıqdan sonra vüsal anı gəlib.", "lang": "az", "family": "homograph_pairs", "pair": 9, "role": "pair", "entities": [{"start": 0, "end": 6, "label": "GIVENNAME"}], "controls": [{"start": 40, "end": 45, "resembles": "GIVENNAME", "kind": "homograph_word"}]}
{"id": "homograph_pairs_011", "text": "Qüdrət yeni mühərrikin qüdrətinə heyran qaldı.", "lang": "az", "family": "homograph_pairs", "pair": 10, "role": "pair", "entities": [{"start": 0, "end": 6, "label": "GIVENNAME"}], "controls": [{"start": 23, "end": 32, "resembles": "GIVENNAME", "kind": "homograph_word"}]}
{"id": "homograph_pairs_012", "text": "Hünər göstərmək lazım idi və Hünər bunu bacardı.", "lang": "az", "family": "homograph_pairs", "pair": 11, "role": "pair", "entities": [{"start": 29, "end": 34, "label": "GIVENNAME"}], "controls": [{"start": 0, "end": 5, "resembles": "GIVENNAME", "kind": "homograph_word"}]}
{"id": "homograph_pairs_013", "text": "Səadətin yeganə arzusu ailəsinin səadəti idi.", "lang": "az", "family": "homograph_pairs", "pair": 12, "role": "pair", "entities": [{"start": 0, "end": 8, "label": "GIVENNAME"}], "controls": [{"start": 33, "end": 40, "resembles": "GIVENNAME", "kind": "homograph_word"}]}
{"id": "homograph_pairs_014", "text": "Sevda mahnısı oxunanda Sevda gülümsədi.", "lang": "az", "family": "homograph_pairs", "pair": 13, "role": "pair", "entities": [{"start": 23, "end": 28, "label": "GIVENNAME"}], "controls": [{"start": 0, "end": 5, "resembles": "GIVENNAME", "kind": "homograph_word"}]}
{"id": "homograph_pairs_015", "text": "Nemətə dedim ki, süfrədəki hər nemət halaldır.", "lang": "az", "family": "homograph_pairs", "pair": 14, "role": "pair", "entities": [{"start": 0, "end": 6, "label": "GIVENNAME"}], "controls": [{"start": 31, "end": 36, "resembles": "GIVENNAME", "kind": "homograph_word"}]}
{"id": "homograph_pairs_016", "text": "Mətanət göstər, — deyə Mətanət qızına pıçıldadı.", "lang": "az", "family": "homograph_pairs", "pair": 15, "role": "pair", "entities": [{"start": 23, "end": 30, "label": "GIVENNAME"}], "controls": [{"start": 0, "end": 7, "resembles": "GIVENNAME", "kind": "homograph_word"}]}

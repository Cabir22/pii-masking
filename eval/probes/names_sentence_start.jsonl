{"id": "names_sentence_start_001", "text": "Qabil Tağıyev dünən yeni vəzifəyə başladı.", "lang": "az", "family": "names_sentence_start", "pair": 0, "role": "full_name", "entities": [{"start": 0, "end": 5, "label": "GIVENNAME"}, {"start": 6, "end": 13, "label": "SURNAME"}]}
{"id": "names_sentence_start_002", "text": "Elmar bu səhər arxivə müraciət etdi.", "lang": "az", "family": "names_sentence_start", "pair": 1, "role": "given_only", "entities": [{"start": 0, "end": 5, "label": "GIVENNAME"}]}
{"id": "names_sentence_start_003", "text": "Toplantı uzun çəkdi. Ülvi Həsənzadə axırda qısa çıxış etdi.", "lang": "az", "family": "names_sentence_start", "pair": 2, "role": "full_name", "entities": [{"start": 21, "end": 25, "label": "GIVENNAME"}, {"start": 26, "end": 35, "label": "SURNAME"}]}
{"id": "names_sentence_start_004", "text": "Cavanşir sənədləri vaxtında təhvil verib.", "lang": "az", "family": "names_sentence_start", "pair": 3, "role": "given_only", "entities": [{"start": 0, "end": 8, "label": "GIVENNAME"}]}
{"id": "names_sentence_start_005", "text": "Hamı gözləyirdi. Sənan Eyvazov isə gecikdi.", "lang": "az", "family": "names_sentence_start", "pair": 4, "role": "full_name", "entities": [{"start": 17, "end": 22, "label": "GIVENNAME"}, {"start": 23, "end": 30, "label": "SURNAME"}]}
{"id": "names_sentence_start_006", "text": "Pərviz layihənin ikinci mərhələsinə rəhbərlik edəcək.", "lang": "az", "family": "names_sentence_start", "pair": 5, "role": "given_only", "entities": [{"start": 0, "end": 6, "label": "GIVENNAME"}]}
{"id": "names_sentence_start_007", "text": "Qeydiyyat bitdi. Şəbnəm Fərzəliyeva siyahının sonunda idi.", "lang": "az", "family": "names_sentence_start", "pair": 6, "role": "full_name", "entities": [{"start": 17, "end": 23, "label": "GIVENNAME"}, {"start": 24, "end": 35, "label": "SURNAME"}]}
{"id": "names_sentence_start_008", "text": "Elmar məzuniyyətdən qayıdıb.", "lang": "az", "family": "names_sentence_start", "pair": 7, "role": "given_only", "entities": [{"start": 0, "end": 5, "label": "GIVENNAME"}]}
{"id": "names_sentence_start_009", "text": "Pərvanə Yusifzadə dünən yeni vəzifəyə başladı.", "lang": "az", "family": "names_sentence_start", "pair": 8, "role": "full_name", "entities": [{"start": 0, "end": 7, "label": "GIVENNAME"}, {"start": 8, "end": 17, "label": "SURNAME"}]}
{"id": "names_sentence_start_010", "text": "Sevil bu səhər arxivə müraciət etdi.", "lang": "az", "family": "names_sentence_start", "pair": 9, "role": "given_only", "entities": [{"start": 0, "end": 5, "label": "GIVENNAME"}]}
{"id": "names_sentence_start_011", "text": "Toplantı uzun çəkdi. Həbib Paşayev axırda qısa çıxış etdi.", "lang": "az", "family": "names_sentence_start", "pair": 10, "role": "full_name", "entities": [{"start": 21, "end": 26, "label": "GIVENNAME"}, {"start": 27, "end": 34, "label": "SURNAME"}]}
{"id": "names_sentence_start_012", "text": "Nüşabə sənədləri vaxtında təhvil verib.", "lang": "az", "family": "names_sentence_start", "pair": 11, "role": "given_only", "entities": [{"start": 0, "end": 6, "label": "GIVENNAME"}]}
{"id": "names_sentence_start_013", "text": "Hamı gözləyirdi. Billurə Cəlilova isə gecikdi.", "lang": "az", "family": "names_sentence_start", "pair": 12, "role": "full_name", "entities": [{"start": 17, "end": 24, "label": "GIVENNAME"}, {"start": 25, "end": 33, "label": "SURNAME"}]}
{"id": "names_sentence_start_014", "text": "Həcər layihənin ikinci mərhələsinə rəhbərlik edəcək.", "lang": "az", "family": "names_sentence_start", "pair": 13, "role": "given_only", "entities": [{"start": 0, "end": 5, "label": "GIVENNAME"}]}
{"id": "names_sentence_start_015", "text": "Qeydiyyat bitdi. Ülvi Sadıqov siyahının sonunda idi.", "lang": "az", "family": "names_sentence_start", "pair": 14, "role": "full_name", "entities": [{"start": 17, "end": 21, "label": "GIVENNAME"}, {"start": 22, "end": 29, "label": "SURNAME"}]}
{"id": "names_sentence_start_016", "text": "Vaqif məzuniyyətdən qayıdıb.", "lang": "az", "family": "names_sentence_start", "pair": 15, "role": "given_only", "entities": [{"start": 0, "end": 5, "label": "GIVENNAME"}]}
{"id": "names_sentence_start_017", "text": "Şahlar Həsənzadə dünən yeni vəzifəyə başladı.", "lang": "az", "family": "names_sentence_start", "pair": 16, "role": "full_name", "entities": [{"start": 0, "end": 6, "label": "GIVENNAME"}, {"start": 7, "end": 16, "label": "SURNAME"}]}
{"id": "names_sentence_start_018", "text": "Eldəniz bu səhər arxivə müraciət etdi.", "lang": "az", "family": "names_sentence_start", "pair": 17, "role": "given_only", "entities": [{"start": 0, "end": 7, "label": "GIVENNAME"}]}
{"id": "names_sentence_start_019", "text": "Toplantı uzun çəkdi. Eldəniz Yusifzadə axırda qısa çıxış etdi.", "lang": "az", "family": "names_sentence_start", "pair": 18, "role": "full_name", "entities": [{"start": 21, "end": 28, "label": "GIVENNAME"}, {"start": 29, "end": 38, "label": "SURNAME"}]}
{"id": "names_sentence_start_020", "text": "Şəbnəm sənədləri vaxtında təhvil verib.", "lang": "az", "family": "names_sentence_start", "pair": 19, "role": "given_only", "entities": [{"start": 0, "end": 6, "label": "GIVENNAME"}]}
{"id": "names_sentence_start_021", "text": "Hesabat dünən təsdiqləndi.", "lang": "az", "family": "names_sentence_start", "pair": 100, "role": "control", "entities": [], "controls": [{"start": 0, "end": 7, "resembles": "GIVENNAME", "kind": "common_noun"}]}
{"id": "names_sentence_start_022", "text": "Anbar bu səhər açıldı.", "lang": "az", "family": "names_sentence_start", "pair": 101, "role": "control", "entities": [], "controls": [{"start": 0, "end": 5, "resembles": "GIVENNAME", "kind": "common_noun"}]}
{"id": "names_sentence_start_023", "text": "Toplantı uzun çəkdi. Qərar axırda qəbul olundu.", "lang": "az", "family": "names_sentence_start", "pair": 102, "role": "control", "entities": [], "controls": [{"start": 21, "end": 26, "resembles": "GIVENNAME", "kind": "common_noun"}]}
{"id": "names_sentence_start_024", "text": "Sənədlər vaxtında təhvil verilib.", "lang": "az", "family": "names_sentence_start", "pair": 103, "role": "control", "entities": [], "controls": [{"start": 0, "end": 8, "resembles": "GIVENNAME", "kind": "common_noun"}]}

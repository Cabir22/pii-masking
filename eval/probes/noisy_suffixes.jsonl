{"id": "noisy_suffixes_001", "text": "Səhər Zakirdan mesaj gəldi.", "lang": "az", "family": "noisy_suffixes", "pair": 0, "role": "name", "entities": [{"start": 6, "end": 14, "label": "GIVENNAME", "noise": "harmony"}]}

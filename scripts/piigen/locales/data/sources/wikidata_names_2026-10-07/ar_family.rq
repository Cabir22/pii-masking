SELECT ?f ?n ?en ?az ?ru ?tr ?ka ?de ?fr WHERE {
  { SELECT ?f (COUNT(DISTINCT ?p) AS ?n) WHERE {
      hint:Query hint:optimizer "None" .
      { SELECT ?p WHERE { ?p wdt:P27 wd:Q79 } LIMIT 20000 } UNION { SELECT ?p WHERE { ?p wdt:P27 wd:Q851 } LIMIT 20000 } UNION { SELECT ?p WHERE { ?p wdt:P27 wd:Q796 } LIMIT 20000 } UNION { SELECT ?p WHERE { ?p wdt:P27 wd:Q858 } LIMIT 20000 } UNION { SELECT ?p WHERE { ?p wdt:P27 wd:Q810 } LIMIT 20000 }
      ?p wdt:P21 wd:Q6581097 ; wdt:P734 ?f .
    } GROUP BY ?f ORDER BY DESC(?n) LIMIT 400 }
  OPTIONAL { ?f rdfs:label ?en FILTER(LANG(?en) = "en") }
  OPTIONAL { ?f rdfs:label ?az FILTER(LANG(?az) = "az") }
  OPTIONAL { ?f rdfs:label ?ru FILTER(LANG(?ru) = "ru") }
  OPTIONAL { ?f rdfs:label ?tr FILTER(LANG(?tr) = "tr") }
  OPTIONAL { ?f rdfs:label ?ka FILTER(LANG(?ka) = "ka") }
  OPTIONAL { ?f rdfs:label ?de FILTER(LANG(?de) = "de") }
  OPTIONAL { ?f rdfs:label ?fr FILTER(LANG(?fr) = "fr") }
} ORDER BY DESC(?n)
